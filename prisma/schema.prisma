generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

enum RefreshTokenStatus {
  ACTIVE
  INACTIVE
}

model RefreshToken {
  id           Int                @id @default(autoincrement())
  userId       Int                @map("user_id")
  refreshToken String             @map("refresh_token")
  status       RefreshTokenStatus @default(ACTIVE)
  expiresAt    DateTime           @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([refreshToken])
  @@map("refresh_token")
}

enum MailVerificationStatus {
  PENDING
  VERIFIED
}

model MailVerification {
  id        Int                    @id @default(autoincrement())
  email     String
  code      String
  status    MailVerificationStatus @default(PENDING)
  tryCount  Int                    @default(0) @map("try_count")
  expiresAt DateTime               @map("expires_at")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@map("mail_verification")
}
