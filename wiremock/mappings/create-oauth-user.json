{
  "request": {
    "method": "POST",
    "url": "/api/v1/users/oauth",
    "headers": {
      "X-Internal": {
        "equalTo": "true"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.email)]"
      },
      {
        "matchesJsonPath": "$[?(@.nickname)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "message": "OAuth user created",
      "data": {
        "userId": 1234
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}